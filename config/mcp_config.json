{
    "Notion": {
        "command": "npx",
        "args": ["-y", "@notionhq/notion-mcp-server"],
        "env": {
            "NOTION_TOKEN": "$NOTION_TOKEN"
        },
        "transport": "stdio"
    },
    "gmail": {
        "command": "npx",
        "args": ["@gongrzhe/server-gmail-autoauth-mcp"],
        "transport": "stdio"
    },
    "google-calendar": {
        "command": "npx",
        "args": ["@cocal/google-calendar-mcp"],
        "env": {
            "GOOGLE_OAUTH_CREDENTIALS": "$GOOGLE_OAUTH_CREDENTIALS"
        },
        "transport": "stdio"
    }
}
